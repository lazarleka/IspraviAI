# Copy to beckend/.env and adjust. Never commit .env.

# PostgreSQL (start it with `docker compose up -d db` in beckend/), ADR-018
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
# SQLite fallback for a quick run without Docker:
# DATABASE_URL=sqlite:///./data/app.db

# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-secret-change-me-before-sharing
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Browser origins allowed to call the API, JSON list
ALLOWED_ORIGINS=["http://localhost:5173"]

# AI card generation (ADR-020). Key from https://aistudio.google.com/apikey
# LLM_PROVIDER=fake returns fixed cards without calling any API (tests, offline demo)
LLM_PROVIDER=fake
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash

# Uploads
MAX_UPLOAD_MB=10
MAX_SOURCE_CHARS=50000
